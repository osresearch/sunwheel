def parse_dms(x):
	if g := re.match(r"([-+]?\d+)([NSEW])(\d+[.]?\d*)?", x):
		print(g[3])
		degs = int(g[1])
		mins = float(g[3])
		sign = -1 if g[2] == "S" or g[2] == "W" else +1
		return (degs + mins / 60) * sign 
	return float(x)

