def fmt_deg(x, zero_deg=False):
	return "%+ 8.3f" % (x)
	return "%+ 8.3f" % (degrees(x))
	x = degrees(x)
	if x < 0:
		neg = '-'
		x = -x
	else:
		neg = ''

	(m,d) = modf(x)
	m *= 60

	if d == 0 and not zero_deg:
		return "%s%.1f'" % (neg,m)
	return "%+4d°%04.1f'" % (-d if neg else d,m)



# The ephem library always wants UTC
def ephem_date(when):
	date = when.isoformat()
	date = re.sub(r"T"," ", date)
	date = re.sub(r"-","/", date)
	return date


# Given a timestamp in UTC, compute the position of the sun
# note that the GHA is positive going west, while longitude
# is positive going east!
def sun_position(when):
	sun = ephem.Sun(ephem_date(when))
	gha = degrees(sun.ha)
	if gha > 180:
		gha -= 360
	return (degrees(sun.dec),gha)
	

# double check with the epehm library
def compute_hc_ephem(lat,lon,when):
	pos = ephem.Observer()
	pos.lat = radians(lat)
	pos.lon = radians(lon)
	pos.elevation = 0
	pos.pressure = 0
	pos.date = ephem_date(when)
	sun = ephem.Sun(pos)
	return (fmt_deg(degrees(sun.alt)), fmt_deg(degrees(sun.az)))

def hczn_table(lat, dec, lha):
	# round all of the values in the correct directions
	lat = floor(lat)
	dec = trunc(dec)
	lha = trunc(lha)
	#print(f"table {lat=} {dec=} {lha=}", file=sys.stderr)
	(hc1,zn) = compute_hczn(lat,dec,lha)

	# compute the d value
	if dec < 0:
		dec -= 1
	else:
		dec += 1
	(hc2,_) = compute_hczn(lat,dec,lha)
	return (hc1,zn,floor((hc2 - hc1) * 100))
	

# Given a lat/lon and time, compute the height of the sun at that position
def compute_hc(lat, lon, when):
	(sun_dec,sun_gha) = sun_position(when)
	# note that longitude is increasing going east,
	# but the sun hour angle is increasing going west.
	# so the angle between them is the sum, not the difference
	lha = lon - (-sun_gha)
	(hc,zn) = compute_hczn(lat, sun_dec, lha)

	return (hc,zn,sun_dec,sun_gha,lha)


